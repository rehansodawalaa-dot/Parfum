# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from: MongoDB Atlas → Connect → Drivers → copy connection string
# Replace <user>, <password>, and <dbname>
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/parfumdb?retryWrites=true&w=majority&appName=parfum

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# Use rzp_test_* keys for testing, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Get from: Razorpay Dashboard → Settings → Webhooks → Webhook Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Frontend URL (CORS) ───────────────────────────────────────────────────────
# Your Vercel frontend URL — no trailing slash
# Multiple URLs supported (comma-separated): https://parfum.vercel.app,https://www.yourstore.com
FRONTEND_URL=https://parfum.vercel.app

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourstore.com

# ── Email (for COD order notifications) ──────────────────────────────────────
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (requires 2FA enabled on your Google account)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password-here
